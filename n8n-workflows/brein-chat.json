  "nodes": [
    {"id":"c1edec5e-0bb2-4ef0-b42f-80b4b7f3c04e","name":"Chat binnenkomst","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,112],"parameters":{"httpMethod":"POST","path":"brein-chat","responseMode":"responseNode","options":{"allowedOrigins":"*"}},"webhookId":"a3619487-9757-43f1-95a8-9c1075daf263"},
    {"id":"cec53c50-d05e-468f-a3a9-97c7a03e2a5a","name":"Bericht normaliseren","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[224,112],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"sessionId","name":"sessionId","value":"={{ $json.body?.sessionId ?? $json.sessionId ?? \"\" }}","type":"string"},{"id":"message","name":"message","value":"={{ $json.body?.message ?? $json.message ?? \"\" }}","type":"string"}]}}},
    {"id":"2cc2ece3-9162-48e9-b4fc-949ce42ae842","name":"BREIN Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[576,112],"parameters":{"promptType":"define","text":"={{ $json.message }}","options":{"systemMessage":"Je bent het brein van Praktijkmeesters. Je praat met de eigenaar en het team, in het Nederlands, kort en in gewone taal.\n\nJe hebt twee geheugens:\n- vraag_cortex: de feiten. Wat er is gebeurd: leads, orders, afspraken, bedragen. Hier haal je elk cijfer en elk feit vandaan.\n- vraag_atlas: het oordeel. De regels, werkwijzen en besluiten van de eigenaar. Hier haal je elke mening en elk advies vandaan.\n\nRegels:\n1. Elk feit komt uit vraag_cortex. Elk oordeel komt uit vraag_atlas. Gok nooit en verzin nooit.\n2. Vindt Atlas niets over een onderwerp, zeg dan eerlijk: daar staat nog niets over in het oordeelgeheugen.\n3. Antwoord eerst, kort, maximaal zes regels. Geen tabelnamen of technische termen richting de gebruiker. Hooguit één wedervraag.\n4. Spreken de twee geheugens elkaar tegen: Atlas wint voor het oordeel, Cortex wint voor het feit.\n5. Vertelt iemand iets dat als regel of besluit klinkt, stel dan voor het vast te leggen, maar schrijf nooit zelf iets weg."}}},
    {"id":"91650792-8562-4e6e-aba7-626a10d78e29","name":"Anthropic Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.6,"position":[448,336],"parameters":{"model":{"__rl":true,"mode":"list","value":"claude-sonnet-5","cachedResultName":"Claude Sonnet 5"}},"credentials":{"anthropicApi":{"id":"JvyLtgrRDv4x2E7n","name":"Anthropic account"}}},
    {"id":"105d7570-89eb-41ee-9d04-bbfead5593d8","name":"Simple Memory","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","typeVersion":1.4,"position":[576,336],"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Bericht normaliseren').item.json.sessionId }}"}},
    {"id":"5b0bd6a4-8370-4724-abb1-d039af284428","name":"vraag_cortex","type":"n8n-nodes-base.httpRequestTool","typeVersion":4.5,"position":[704,336],"parameters":{"toolDescription":"Hiermee lees je de feiten. Schrijf één SELECT-query op de tabel cortex_events (kolommen: gebeurd_op, type, wie, bron, bedrag, omschrijving, data). Alleen lezen, één vraag per keer.","method":"POST","url":"https://ogqbciiteqogopnjltnc.supabase.co/rest/v1/rpc/vraag_cortex","authentication":"predefinedCredentialType","nodeCredentialType":"supabaseApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"json","specifyBody":"keypair","bodyParameters":{"parameters":[{"name":"p_sql","value":"={{ $fromAI('p_sql', 'De SELECT-query die je wilt uitvoeren op cortex_events') }}"}]}},"credentials":{"supabaseApi":{"id":"W8sb6XqkjKJBXRee","name":"Supabase account"}}},
    {"id":"9f43d365-5000-46d9-b585-01aa46af53f8","name":"vraag_atlas","type":"n8n-nodes-base.httpRequestTool","typeVersion":4.5,"position":[832,336],"parameters":{"toolDescription":"Hiermee zoek je het oordeel van de eigenaar: regels, werkwijzen, besluiten. Stel de vraag in gewone taal. Het antwoord zegt per notitie of hij de woorden van de vraag dekt (woordtreffer). Staat gevonden op 0, dan ligt er waarschijnlijk niets over vast.","method":"POST","url":"https://ogqbciiteqogopnjltnc.supabase.co/functions/v1/atlas-balie/vraag","authentication":"none","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer __ANON_KEY__"},{"name":"x-atlas-key","value":"__ATLAS_SLEUTEL__"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"json","specifyBody":"keypair","bodyParameters":{"parameters":[{"name":"vraag","value":"={{ $fromAI('vraag', 'De zoekvraag in gewone taal') }}"}]}}},
